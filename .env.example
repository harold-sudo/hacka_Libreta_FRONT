# URL del Gateway NestJS (backend opcional de la plataforma)
VITE_API_URL=http://localhost:3001

# --- HSK Chain (Track HSK Chain) ---
# Red objetivo: 133 = HashKey Chain Testnet | 177 = HashKey Chain Mainnet
VITE_HSK_CHAIN_ID=133

# Dirección del contrato LibretaRegistry desplegado en HSK Chain
VITE_HSK_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Explorador HSK Chain
VITE_HSK_EXPLORER_URL=https://testnet-explorer.hsk.xyz

# Pollar: crea una app Stellar TESTNET; solo clave publicable (nunca secreta).
# Copia este archivo a .env.local y reinicia Vite después de configurarla.
VITE_POLLAR_PUBLISHABLE_KEY=

# Integración Unlock Protocol (Bounty Unlock - Token-Gated Audit Dossier)
VITE_UNLOCK_LOCK_ADDRESS=0x0000000000000000000000000000000000000000
VITE_UNLOCK_NETWORK=8453
